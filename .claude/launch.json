{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "landing",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:LANDING_DB = Join-Path $env:TEMP 'everselife-landing-signups.db'; if (-not $env:PORT) { $env:PORT = '8123' }; & '../backend/.venv/Scripts/python.exe' -m uvicorn app:app --port $env:PORT"
      ],
      "cwd": "landing",
      "port": 8123,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "src.api.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "backend-worker",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:EVERSELIFE_VAULT_BUILD='C:/Users/nurla/PycharmProjects/everselife-vault/build'; & 'C:/Users/nurla/PycharmProjects/everselife/backend/.venv/Scripts/python.exe' -m src.worker"
      ],
      "cwd": "backend"
    },
    {
      "name": "backend-check",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "src.api.app:app",
        "--port",
        "8001"
      ],
      "cwd": "backend",
      "port": 8001
    },
    {
      "name": "frontend-check",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:VITE_API = 'http://localhost:8001'; npm run dev -- --port 5174 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5174
    },
    {
      "name": "frontend-clean",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "npm run dev -- --port 5176 --strictPort"
      ],
      "cwd": ".claude/worktrees/ui-check/frontend",
      "port": 5176
    },
    {
      "name": "vault-editor",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "../everselife-vault/editor/server.py",
        "--port",
        "8766",
        "--no-browser"
      ],
      "port": 8766
    },
    {
      "name": "backend-globe",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:EVERSELIFE_DATABASE_URL='postgresql+asyncpg://everselife:everselife@localhost/everselife_play'; $env:EVERSELIFE_VAULT_BUILD='C:/Users/nurla/PycharmProjects/everselife-vault/build'; & 'C:/Users/nurla/PycharmProjects/everselife/backend/.venv/Scripts/python.exe' -m uvicorn src.api.app:app --port 8002"
      ],
      "cwd": "backend",
      "port": 8002
    },
    {
      "name": "frontend-globe",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:VITE_API='http://localhost:8002'; npm run dev -- --port 5177 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5177
    },
    {
      "name": "backend-zoom",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:EVERSELIFE_DATABASE_URL='postgresql+asyncpg://everselife:everselife@localhost/everselife_zoom'; $env:EVERSELIFE_VAULT_BUILD='C:/Users/nurla/PycharmProjects/everselife-vault/build'; & 'C:/Users/nurla/PycharmProjects/everselife/backend/.venv/Scripts/python.exe' -m uvicorn src.api.app:app --port 8003"
      ],
      "cwd": "backend",
      "port": 8003
    },
    {
      "name": "frontend-zoom",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:VITE_API='http://localhost:8003'; npm run dev -- --port 5178 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5178
    },
    {
      "name": "backend-look",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:EVERSELIFE_DATABASE_URL='postgresql+asyncpg://everselife:everselife@localhost/everselife_look'; $env:EVERSELIFE_VAULT_BUILD='C:/Users/nurla/PycharmProjects/everselife-vault/build'; & 'C:/Users/nurla/PycharmProjects/everselife/backend/.venv/Scripts/python.exe' -m uvicorn src.api.app:app --port 8004"
      ],
      "cwd": "backend",
      "port": 8004
    },
    {
      "name": "frontend-look",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:VITE_API='http://localhost:8004'; npm run dev -- --port 5200 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5200
    }
  ]
}
