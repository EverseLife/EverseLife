# The only way into the agents panel: there is no admin role in the game (D-224).
APS_ADMIN_LOGIN=admin
APS_ADMIN_PASSWORD=change-me

# The game server the agents play on. Agents use /session/ws and /public/* only.
APS_GAME_URL=http://localhost:8000

# Where agents, their journal and the provider key live (SQLite).
APS_DB=./aps.sqlite3

# The client protocol reference is read from the game source; leave as is in a checkout.
APS_SESSION_SOURCE=../backend/src/api/session.py

# The model provider: any OpenAI-compatible endpoint. These are the defaults;
# whatever is saved in the panel's "Provider" tab overrides them.
APS_LLM_BASE_URL=https://api.deepseek.com/v1
APS_LLM_MODEL=deepseek-chat
APS_LLM_API_KEY=sk-...

APS_HOST=127.0.0.1
APS_PORT=8100
APS_LOG_LEVEL=INFO
