# Граница мира: TLS, клиент, сервер.
#
# Сертификат Caddy берёт сам (ACME, HTTP-01) и сам продлевает — отдельного
# certbot и задания в cron не нужно. Условие одно: домен из `DOMAIN` указывает
# A-записью на этот сервер, а порты 80 и 443 открыты.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Сервер игры. Префикс снимается: наружу `/api/public/...`, внутрь
	# `/public/...`. Сюда же уходит сокет сессии (`/api/session/ws`) —
	# обновление соединения Caddy проносит сам.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Всё остальное — собранный клиент.
	handle {
		reverse_proxy frontend:80
	}

	# Опознания в альфе нет: любой может назваться любым именем (заглушка до
	# Э7). Пока это так, закрытую альфу разумно прикрыть дверью с паролем —
	# снять решётку # и подставить хэш от
	# `docker run --rm caddy:2-alpine caddy hash-password`.
	#
	# Важно: пароль на границе прикрывает страницу и чтение, но браузеры
	# по-разному ведут себя с сокетом — если после входа сессия не поднимается,
	# исключите из двери путь сокета (`@ws path /api/session/ws`) либо
	# ограничьте доступ по адресу в брандмауэре.
	# basic_auth {
	# 	alpha $2a$14$...
	# }

	log {
		output stdout
		format console
	}
}
