# The world's edge: TLS, client, server.
#
# Caddy obtains the certificate itself (ACME, HTTP-01) and renews it itself --
# no separate certbot or cron job is needed. One condition: the domain from
# `DOMAIN` points to this server with an A record, and ports 80 and 443 are open.
{
	email {$ACME_EMAIL}

	# No HTTP/3. Caddy would otherwise listen on UDP/443 and advertise it with
	# `Alt-Svc` for a month ahead, and Russian providers filter UDP/443 widely:
	# a browser that remembered the offer spends the wait on QUIC before
	# falling back to TCP, on every visit, and differently on every network --
	# which is what "opens fine on mobile, crawls over home wifi" looks like.
	# The udp port stays published in `compose.yaml`, so putting h3 back is
	# this line and nothing else. Worth doing the day that filtering stops:
	# where QUIC is allowed to work it is the faster protocol.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip

	# The game server. The prefix is stripped: outside `/api/public/...`,
	# inside `/public/...`. The session socket (`/api/session/ws`) goes here
	# too -- Caddy carries the connection upgrade itself.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Everything else -- the built client.
	handle {
		reverse_proxy frontend:80
	}

	# There is no identification in the alpha: anyone can call themselves any
	# name (a stub until E7). While that is so, it is sensible to put the
	# closed alpha behind a password door -- remove the # and substitute the
	# hash from `docker run --rm caddy:2-alpine caddy hash-password`.
	#
	# Important: a password at the edge covers the page and reads, but browsers
	# behave differently with the socket -- if the session does not come up
	# after login, exclude the socket path from the door (`@ws path /api/session/ws`)
	# or restrict access by address in the firewall.
	# basic_auth {
	# 	alpha $2a$14$...
	# }

	log {
		output stdout
		format console
	}
}

# The landing with beta signup intake. Until LANDING_DOMAIN is set in `.env`,
# the default `landing.localhost` keeps the block on an internal certificate
# and Caddy does not go for a real one. To open everse.life:
#   1. an A record `everse.life` -> this server's address;
#   2. `LANDING_DOMAIN=everse.life` in `.env`;
#   3. `docker compose up -d --force-recreate caddy`.
{$LANDING_DOMAIN} {
	encode zstd gzip

	reverse_proxy landing:8080

	log {
		output stdout
		format console
	}
}

# The AI citizens panel (D-224). Same rule as the landing: until AGENTS_DOMAIN
# is set in `.env`, the block sits on an internal name and Caddy does not go
# for a certificate. To open agents.everse.life:
#   1. an A record `agents.everse.life` -> this server's address;
#   2. `AGENTS_DOMAIN=agents.everse.life` and `AGENTS_ADMIN_PASSWORD=...` in `.env`;
#   3. `docker compose up -d --force-recreate caddy agents`.
{$AGENTS_DOMAIN:agents.localhost} {
	encode zstd gzip

	reverse_proxy agents:8100

	log {
		output stdout
		format console
	}
}

# `www.` lives as a separate line: it needs its own DNS record (an A record or
# a CNAME to the bare domain -- ACME only needs the name to resolve here) and
# its own certificate. Without this block Caddy has no site for that name, so
# it breaks the TLS handshake instead of redirecting, and every `www.` link is
# dead. The redirect is permanent, so search engines keep one address.
www.{$LANDING_DOMAIN} {
	redir https://{$LANDING_DOMAIN}{uri} permanent
}

# The old domain as a signpost, not a site: links to it are already out in
# Discord and in beta invites, and a dead link is worse than a redirect. Set
# LEGACY_DOMAINS in `.env` (comma separated) while its A records still point
# here; unset, the block stays on an internal name and Caddy does not go for a
# certificate. Drop the line when the old links are no longer worth serving.
{$LEGACY_DOMAINS:legacy.localhost} {
	redir https://{$LANDING_DOMAIN:landing.localhost}{uri} permanent

	log {
		output stdout
		format console
	}
}
