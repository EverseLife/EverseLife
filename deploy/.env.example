# Настройки боевого состава. На сервере лежит рядом с `compose.yaml`
# под именем `.env` и в репозиторий не попадает — там пароль базы.
#
#   cp .env.example .env && nano .env

# Домен альфы. A-запись должна указывать на этот сервер: по ней Caddy получает
# сертификат, и её же клиент считает адресом сервера.
DOMAIN=alpha.example.com

# Домен лендинга с приёмом заявок на бету. Пока строка не задана, лендинг
# наружу не смотрит. Открыть: A-запись на этот сервер, потом сюда домен.
#LANDING_DOMAIN=example.com

# Почта для Let's Encrypt: туда придёт письмо, если с продлением беда.
ACME_EMAIL=you@example.com

# Пароль базы. Придумать длинный и случайный:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Чей это образ в GHCR (владелец репозитория на GitHub).
GHCR_OWNER=sumrak10

# Какую сборку запускать. `latest` — последняя с ветки main. Для отката
# поставить сюда отпечаток коммита (тег образа) и поднять состав заново.
TAG=latest

# Разговорчивость сервера: INFO в альфе полезен, DEBUG заливает диск.
OCTOVERSE_LOG_LEVEL=INFO

# Сколько заданий журнала воркер берёт за проход.
OCTOVERSE_JOB_BATCH=64

# Вебхук канала хроники в Discord: воркер относит туда основания городов,
# приговоры, выборы и ставку банка. Пусто — глашатай молчит.
# Где взять: канал → Настройки → Интеграции → Вебхуки → Создать.
#OCTOVERSE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...

# Вебхук служебного канала заявок: лендинг сообщает, что пришла ещё одна
# заявка на бету, и сколько их всего. Адресов почты туда не уходит.
#LANDING_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...
