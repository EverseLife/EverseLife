# Production compose settings. On the server it lies next to `compose.yaml`
# under the name `.env` and does not go into the repository -- the database password is there.
#
#   cp .env.example .env && nano .env

# The alpha's domain. The A record must point to this server: Caddy obtains
# the certificate by it, and the client takes it as the server address.
DOMAIN=alpha.example.com

# The landing domain with beta signup intake. Until the line is set, the
# landing does not face outside. To open: an A record to this server, then the domain here.
#LANDING_DOMAIN=example.com

# The AI citizens panel (D-224): its own domain and the only login to it.
# Until AGENTS_DOMAIN is set, the panel does not face outside.
#AGENTS_DOMAIN=agents.example.com
#AGENTS_ADMIN_LOGIN=admin
#AGENTS_ADMIN_PASSWORD=
# The model provider (any OpenAI-compatible endpoint); the panel can override these.
#AGENTS_LLM_BASE_URL=https://api.deepseek.com/v1
#AGENTS_LLM_MODEL=deepseek-chat
#AGENTS_LLM_API_KEY=sk-...
# Seals agent passwords and the provider key in the panel's store. Make one with
#   docker run --rm ghcr.io/everselife/everselife-agents:latest \n#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first, keep the old one after a comma until the
# panel has rewritten everything (it reseals on save).
#AGENTS_SECRET_KEY=

# Old domains that now only send visitors to the landing, comma separated.
# Worth keeping while links to them are still out in Discord and in
# invites; their A records must still point to this server.
#LEGACY_DOMAINS=octoverse.world, alpha.octoverse.world

# Email for Let's Encrypt: a letter comes there if renewal is in trouble.
ACME_EMAIL=you@example.com

# The database password. Make it long and random:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Whose image this is in GHCR (the repository owner on GitHub).
GHCR_OWNER=everselife

# Which build to run. `latest` is the latest from the main branch. To roll
# back, put the commit fingerprint (image tag) here and bring the compose up again.
TAG=latest

# Server verbosity: INFO is useful in the alpha, DEBUG floods the disk.
EVERSELIFE_LOG_LEVEL=INFO

# How many journal jobs the worker takes per pass.
EVERSELIFE_JOB_BATCH=64

# How many server processes serve players. One process is one core, whatever
# the machine has, so this is the setting that decides how many people play at
# once. Leave the machine a couple of cores: the worker drives the world and
# the database needs its own. On six cores four is right; on two, one.
EVERSELIFE_WEB_WORKERS=4

# Database connections per process, and how many more at a peak. A session
# command holds a connection while its transaction runs, so this is how many
# players are served at the same instant by one process.
EVERSELIFE_DB_POOL_SIZE=10
EVERSELIFE_DB_MAX_OVERFLOW=5

# The database's own ceiling. It must cover every pool at once:
# (WEB_WORKERS + 1 for the worker) * (POOL_SIZE + MAX_OVERFLOW), plus the
# `migrate` and `seed` runs of a deploy. With the numbers above: 5 * 15 = 75.
POSTGRES_MAX_CONNECTIONS=200

# Grafana's admin password. The panel listens on the server's loopback and is
# opened through an SSH tunnel, but `admin` is still worth replacing.
#GRAFANA_ADMIN_PASSWORD=

# Where Grafana sends alerts -- disk running out, memory at the ceiling, the
# database silent. Empty: alerts fire and stay in the interface.
#GRAFANA_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...

# How deep the metric history goes. Longer means more disk under Prometheus.
#PROMETHEUS_RETENTION=15d

# The Discord chronicle channel webhook: the worker carries city foundings,
# verdicts, elections and the bank rate there. Empty -- the herald is silent.
# Where to get it: channel -> Settings -> Integrations -> Webhooks -> Create.
#EVERSELIFE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...

# The signup service channel webhook: the landing reports that one more beta
# signup came, and how many in total. No email addresses go there.

#LANDING_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...
