# Что мир объявляет вслух: строки хроники в Discord (`herald/chronicle.py`).
#
# Хроника уходит в один канал одной аудитории, поэтому — в отличие от отказа —
# говорится не на языке читателя, а на языке канала: `compose` рендерит её на
# языке мира по умолчанию. Слова всё равно лежат здесь, а не в f-строках: канал
# на другом языке — это `locale=` в одном месте, а не файл, переписанный заново.
#
# Эмодзи и разметка Discord (`**жирный**`) — часть строки: они оформляют
# предложение, и где в предложении встанет выделение, решает язык.
#
# Значение — одной строкой; варианты выбора — каждый на своей строке.
# Ключ варианта в Fluent — идентификатор, а не строка и не булево, поэтому
# «есть ли имя», «прошло ли» и прочее приходят флагом `"true"`/`"false"`.

# Что стоит на месте имени, когда имени нет: строка события пережила запись,
# на которую ссылалась. Слова, а не заглушки, — и потому здесь.
chronicle-someone = неизвестно кто
chronicle-somewhere = где-то

chronicle-city-founded = 🏛 **Основан город { $city }** — { $where }. Кто основал: { $who }.

chronicle-city-law-set = 📐 { $city }: код-закон «{ $named ->
        [true] { $law }
       *[false] закон
    }» — было { $was }, стало { $now }.

chronicle-city-charter-set = 📜 { $city }: устав — «{ $named ->
        [true] { $question }
       *[false] вопрос устава
    }» теперь «{ $choice }».

# Вид голосования приходит значением перечисления (`VoteKind`), словом
# становится здесь. `unknown` — не пропущенный вариант, а свой: строку стоит
# объявить и тогда, когда самой записи голосования уже нет, счёт-то в событии.
chronicle-vote-closed = 🗳 { $city }: { $kind ->
        [law] голосование по закону
        [election] выборы правителя
        [recall] отзыв правителя
        [charter] правка устава
        [council] выборы в совет
       *[unknown] голосование
    } — { $passed ->
        [true] прошло
       *[false] не прошло
    } (за { $yes }, против { $no }, голосующих { $electorate }).

chronicle-council-seated = 🪑 { $city }: место в совете занимает { $who }.

chronicle-case-judged = ⚖️ Суд города { $city }. Судья: { $judge }.{ $sentenced ->
        [true] { " " }Приговор: «{ $verdict }».
       *[false] {""}
    }{ $sanctioned ->
        [true] { " " }Санкция: { $sanction }.
       *[false] { " " }Без санкции.
    }

# Ставка объявляется, только когда сдвинулась, — решает `_rate_decided`, а не
# сообщение. Объяснение приходит уже собранным из своих же ключей: это список
# причин, и как их связать — дело языка (`i18n.join`).
chronicle-rate-decided = 🏦 Ключевая ставка{ $by_council ->
        [true] { " " }(решение совета, { $city })
       *[false] {""}
    }: **{ $rate }**{ $known ->
        [true] { " " }(было { $was })
       *[false] {""}
    }.{ $explained ->
        [true] { " " }{ $why }
       *[false] {""}
    }

chronicle-explore-found = 🧭 Разведка{ $from_known ->
        [true] { " " }от узла { $from_node }
       *[false] {""}
    }: карта приросла — { $what }. Разведчик: { $who }.
