# Path to the game-design vault's build/ directory. The engine reads only it.
OCTOVERSE_VAULT_BUILD=../../octoverse-game-design/build

OCTOVERSE_DATABASE_URL=postgresql+asyncpg://octoverse:octoverse@localhost:5432/octoverse
OCTOVERSE_REDIS_URL=redis://localhost:6379/0

# How many journal jobs are taken per worker pass.
OCTOVERSE_JOB_BATCH=64

OCTOVERSE_LOG_LEVEL=INFO
