# Path to the game-design vault's build/ directory. The engine reads only it.
EVERSELIFE_VAULT_BUILD=../../everselife-vault/build

EVERSELIFE_DATABASE_URL=postgresql+asyncpg://everselife:everselife@localhost:5432/everselife
EVERSELIFE_REDIS_URL=redis://localhost:6379/0

# How many journal jobs are taken per worker pass.
EVERSELIFE_JOB_BATCH=64

EVERSELIFE_LOG_LEVEL=INFO
