#!/bin/sh
# Pre-commit: run the same lint CI runs, so a red run never starts.
#
# Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Emergency bypass: git commit --no-verify

set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo/backend"

# The project venv first: it holds the ruff version pinned by uv.lock, the very
# one CI runs. Everything else is a fallback for a fresh clone.
if [ -x .venv/Scripts/python.exe ]; then
    lint=".venv/Scripts/python.exe -m ruff check ."
elif [ -x .venv/bin/python ]; then
    lint=".venv/bin/python -m ruff check ."
elif command -v ruff > /dev/null 2>&1; then
    lint="ruff check ."
elif command -v uv > /dev/null 2>&1; then
    lint="uv run --frozen ruff check ."
else
    echo "pre-commit: ruff not found -- create backend/.venv or install ruff" >&2
    exit 1
fi

if ! $lint; then
    echo >&2
    echo "pre-commit: lint failed, CI would stop here too" >&2
    echo "pre-commit: most of it fixes itself -- cd backend && ruff check . --fix" >&2
    exit 1
fi

# A snapshot lagging behind the vault breaks every test at constants load --
# the engine asks for a number the snapshot does not have -- and in the CI log
# that looks like anything but a stale file. It has cost three red runs, so it
# is a veto now, not a warning. The vault lives next to the repository and may
# be absent: on a machine without it there is nothing to compare, and the check
# stays quiet.
vault="$repo/../octoverse-game-design/build"
stale=""
if [ -d "$vault" ]; then
    for name in constants laws plants recipes; do
        if [ -f "$vault/$name.json" ] \
            && ! cmp -s "$repo/vault/$name.json" "$vault/$name.json"; then
            stale="$stale $name.json"
        fi
    done
fi

if [ -n "$stale" ]; then
    echo >&2
    echo "pre-commit: the vault snapshot lags behind the vault:$stale" >&2
    echo "pre-commit: refresh it -- powershell -File deploy/sync-vault.ps1" >&2
    exit 1
fi
