# Pre-commit: run the same lint CI runs, so a red run never starts.
#
# Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Emergency bypass: git commit --no-verify

set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo/backend"

# The project venv first: it holds the ruff version pinned by uv.lock, the very
# one CI runs. Everything else is a fallback for a fresh clone.
if [ -x .venv/Scripts/python.exe ]; then
    lint=".venv/Scripts/python.exe -m ruff check ."
elif [ -x .venv/bin/python ]; then
    lint=".venv/bin/python -m ruff check ."
elif command -v ruff > /dev/null 2>&1; then
    lint="ruff check ."
elif command -v uv > /dev/null 2>&1; then
    # `--extra dev` is not optional here: ruff lives in that extra, and
    # without it uv builds an environment where the linter is missing.
    lint="uv run --frozen --extra dev ruff check ."
else
    echo "pre-commit: ruff not found -- create backend/.venv or install ruff" >&2
    exit 1
fi

if ! $lint; then
    echo >&2
    echo "pre-commit: lint failed, CI would stop here too" >&2
    echo "pre-commit: most of it fixes itself -- cd backend && ruff check . --fix" >&2
    exit 1
fi

# The snapshot is not in the repository any more: CI builds it from the vault,
# and `vault/` here is scratch. Nothing left to compare, so the hook checks the
# lint and nothing else.
