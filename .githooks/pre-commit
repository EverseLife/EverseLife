# Pre-commit: run the same lint CI runs, so a red run never starts.
#
# Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Emergency bypass: git commit --no-verify

set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo/backend"

# The project venv first: it holds the ruff version pinned by uv.lock, the very
# one CI runs. Everything else is a fallback for a fresh clone.
if [ -x .venv/Scripts/python.exe ]; then
    lint=".venv/Scripts/python.exe -m ruff check ."
elif [ -x .venv/bin/python ]; then
    lint=".venv/bin/python -m ruff check ."
elif command -v ruff > /dev/null 2>&1; then
    lint="ruff check ."
elif command -v uv > /dev/null 2>&1; then
    # `--extra dev` is not optional here: ruff lives in that extra, and
    # without it uv builds an environment where the linter is missing.
    lint="uv run --frozen --extra dev ruff check ."
else
    echo "pre-commit: ruff not found -- create backend/.venv or install ruff" >&2
    exit 1
fi

#: The same runner, for the format check and the layers contract.
runner="${lint% -m ruff check .}"
runner="${runner%ruff check .}"
if [ -n "$runner" ] && [ "$runner" != "$lint" ]; then
    if ! $runner -m ruff format --check . > /dev/null 2>&1 && ! ${runner}ruff format --check . > /dev/null 2>&1; then
        echo "pre-commit: ruff format --check failed -- cd backend && ruff format ." >&2
        exit 1
    fi
fi
#: `PYTHONIOENCODING`: import-linter draws with emoji, and a Windows console
#: in cp1251 would crash on them before reporting anything.
if [ -x .venv/Scripts/lint-imports.exe ]; then
    PYTHONIOENCODING=utf-8 .venv/Scripts/lint-imports.exe > /dev/null || { echo "pre-commit: layers contract broken (lint-imports)" >&2; exit 1; }
elif [ -x .venv/bin/lint-imports ]; then
    .venv/bin/lint-imports > /dev/null || { echo "pre-commit: layers contract broken (lint-imports)" >&2; exit 1; }
fi

if ! $lint; then
    echo >&2
    echo "pre-commit: lint failed, CI would stop here too" >&2
    echo "pre-commit: most of it fixes itself -- cd backend && ruff check . --fix" >&2
    exit 1
fi

# The licence header in every source file. Same reason as the lint: CI checks
# it too, and one command fixes the whole repository.
cd "$repo"

if [ -x backend/.venv/Scripts/python.exe ]; then
    py="backend/.venv/Scripts/python.exe"
elif [ -x backend/.venv/bin/python ]; then
    py="backend/.venv/bin/python"
elif command -v python3 > /dev/null 2>&1; then
    py="python3"
elif command -v python > /dev/null 2>&1; then
    py="python"
else
    echo "pre-commit: python not found -- cannot check licence headers" >&2
    exit 1
fi

# The script prints what is missing and how to fix it, so nothing to add here.
if ! "$py" tools/spdx.py; then
    exit 1
fi

# The sitemap dates its pages by content, not by mtime, so the stamps have to
# be restamped when a page changes -- see landing/lastmod.py. Only with a
# python that has FastAPI: the script reads the page list from the landing app,
# and a bare system python would fail on the import instead of on the stamps.
if "$py" -c "import fastapi" > /dev/null 2>&1; then
    if ! "$py" landing/lastmod.py --check; then
        exit 1
    fi
fi

# The served typefaces are cut down to the characters the pages can show, so
# new text outgrows them -- and it does so silently, one letter falling back to
# another face on somebody else's screen. Only with fontTools: a clone without
# it skips the check rather than failing on a tool it was never asked to have.
if "$py" -c "import fontTools" > /dev/null 2>&1; then
    if ! "$py" landing/subset_fonts.py --check; then
        exit 1
    fi
fi

# Every language says what the default one says -- the engine's words and the
# window's own, by the same script (D-251). A new string written in Russian
# alone is the one i18n regression that shows nothing at all: Fluent falls back
# to the default language, and an English player reads a Russian button while
# every test passes. Only with the Fluent parser: a clone without it skips the
# check rather than failing on a tool it was never asked to have.
if "$py" -c "import fluent.syntax" > /dev/null 2>&1; then
    if ! "$py" backend/tools/check_locales.py; then
        echo "pre-commit: the engine's languages diverged -- see above" >&2
        exit 1
    fi
    if ! "$py" backend/tools/check_locales.py --tree frontend/src/locales; then
        echo "pre-commit: the client's languages diverged -- see above" >&2
        exit 1
    fi
fi

# The vault snapshot is not in the repository any more: CI builds it from the
# vault, and `vault/` here is scratch. Nothing left to compare.
